# Supabase — chaves públicas (podem ir para o cliente)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase — chave de serviço. NUNCA no cliente nem no wrangler.jsonc.
# Em produção: Secret no Worker (Settings → Variables and Secrets).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend — envio de emails transacionais.
# NUNCA no wrangler.jsonc (está no git). Em produção: Secret no Worker.
# Sem esta chave a app funciona à mesma: os emails são simplesmente ignorados.
RESEND_API_KEY=re_your_api_key_here

# Stripe — pagamentos. NUNCA no wrangler.jsonc. Em produção: Secret no Worker.
# Modo teste primeiro (sk_test_.../whsec_ do endpoint de teste), produção
# só depois de validar tudo (sk_live_.../whsec_ do endpoint live — são
# segredos DIFERENTES, cada endpoint de webhook tem o seu).
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
